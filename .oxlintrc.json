{
  "$schema": "https://oxc-project.github.io/schemas/oxlint.json",
  "ignorePatterns": [
    "android-test/app/src/main/assets/**",
    "android-test/app/build/**",
    "android-test/.gradle/**",
    "android-test/build/**",
    "android-test/smoke-bundle.mjs",
    "dist/**",
    "dist-server/**",
    "dist-companion/**",
    "dist-electron/**",
    "dist-native/**",
    "third_party/**",
    "electron/vendor/**",
    "*.tsbuildinfo",
    "node_modules/**"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-unused-expressions": "warn"
  }
}
